import cv2
import numpy as np

# Open webcam
cap = cv2.VideoCapture(0)

while True:
    ret, frame = cap.read()

    if not ret:
        break

    # Resize frame
    frame = cv2.resize(frame, (640, 480))

    # Convert to grayscale
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    # Blur image to reduce noise
    blur = cv2.GaussianBlur(gray, (5, 5), 0)

    # Edge detection
    edges = cv2.Canny(blur, 50, 150)

    # Define Region of Interest (Center Area)
    h, w = edges.shape
    roi = edges[h//3:h, w//3:2*w//3]

    # Count obstacle pixels
    obstacle_pixels = cv2.countNonZero(roi)

    # Threshold for obstacle detection
    threshold = 5000

    if obstacle_pixels > threshold:
        left_roi = roi[:, :roi.shape[1]//2]
        right_roi = roi[:, roi.shape[1]//2:]

        left_count = cv2.countNonZero(left_roi)
        right_count = cv2.countNonZero(right_roi)

        if left_count > right_count:
            action = "TURN RIGHT"
        else:
            action = "TURN LEFT"
    else:
        action = "MOVE FORWARD"

    # Display action
    cv2.putText(frame, action, (20, 40),
                cv2.FONT_HERSHEY_SIMPLEX,
                1, (0, 255, 0), 2)

    # Draw ROI
    cv2.rectangle(frame,
                  (w//3, h//3),
                  (2*w//3, h),
                  (255, 0, 0), 2)

    cv2.imshow("Obstacle Avoidance", frame)
    cv2.imshow("Edges", edges)

    key = cv2.waitKey(1)

    if key == 27:  # ESC key
        break

cap.release()
cv2.destroyAllWindows()
